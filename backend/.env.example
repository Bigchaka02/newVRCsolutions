# Copy to .env and fill in. Never commit .env.

APP_ENV=development
DATABASE_URL=sqlite:///./vrc.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,https://vrcsolutions.co,https://www.vrcsolutions.co

# Long random string. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=change-me-before-deploying

# Salt for hashing IPs in the compliance audit log. We store a hash, never a
# raw address, so the log survives a breach without leaking visitor IPs.
IP_HASH_SALT=change-me-too

# Outbound email. Leave blank to log messages to stdout instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=support@vrcsolutions.co

# Manual payment rails.
VENMO_HANDLE=@vrcsolutions
CASHAPP_HANDLE=$vrcsolutions
BTC_ADDRESS=
ETH_ADDRESS=
USDC_ADDRESS=

# Per-route limits on orders, contact and order lookup. Keep on in production.
RATE_LIMIT_ENABLED=true

# Single-process mode: this app also serves the built site from ../public.
# Leave false when the site is deployed to a CDN such as Cloudflare Pages.
SERVE_STATIC=false

# ---- Integrations: placeholders until the original backend is supplied ----
# Blank = placeholder mode. Status: GET /api/admin/integrations (admin token).
CARD_PROCESSOR=
CARD_API_KEY=
CARD_WEBHOOK_SECRET=
CRYPTO_PROCESSOR=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Old WordPress site, for the one-time WooCommerce import
# (WooCommerce > Settings > Advanced > REST API, read-only key)
WOO_URL=https://vrcsolutions.co
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
ANALYTICS_ID=
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
